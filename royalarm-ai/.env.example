# ==============================================================================
# RoyalArm AI Environment Variables
# Copy this file to .env.local for local development. Never commit .env.local.
# ==============================================================================

# Optional server-only provider key. Leave unset for local-only mode.
OPENAI_API_KEY=your_openai_api_key_here

# Personal application plan, enforced server-side. Changing this is an operator action.
AI_ACTIVE_PLAN=free

# Model IDs wired to the chat selector. Defaults are gpt-4.1-mini (Free),
# gpt-4o-mini (Free economy), and gpt-4.1 (Pro). Do not treat this app plan
# as free provider API usage; provider billing and quotas are separate.
OPENAI_FREE_MODEL=gpt-4.1-mini
OPENAI_FREE_ECONOMY_MODEL=gpt-4o-mini
OPENAI_PRO_MODEL=gpt-4.1

# Optional per-request budgets; each value is capped at its model's documented maximum.
# OPENAI_FREE_CONTEXT_TOKENS=8192
# OPENAI_FREE_OUTPUT_TOKENS=2048
# OPENAI_FREE_ECONOMY_CONTEXT_TOKENS=8192
# OPENAI_FREE_ECONOMY_OUTPUT_TOKENS=2048
# OPENAI_PRO_CONTEXT_TOKENS=32768
# OPENAI_PRO_OUTPUT_TOKENS=4096
# AI_FREE_CONTEXT_TOKENS=4000
# AI_FREE_OUTPUT_TOKENS=1024
# AI_FREE_REQUESTS_PER_MINUTE=10
# AI_PRO_CONTEXT_TOKENS=16000
# AI_PRO_OUTPUT_TOKENS=4096
# AI_PRO_REQUESTS_PER_MINUTE=20

# Optional provider prices are displayed only when both values for a model are set.
# OPENAI_FREE_INPUT_USD_PER_MILLION=0.40
# OPENAI_FREE_OUTPUT_USD_PER_MILLION=1.60
# OPENAI_FREE_ECONOMY_INPUT_USD_PER_MILLION=0.15
# OPENAI_FREE_ECONOMY_OUTPUT_USD_PER_MILLION=0.60
# OPENAI_PRO_INPUT_USD_PER_MILLION=2
# OPENAI_PRO_OUTPUT_USD_PER_MILLION=8

# Optional application plan display prices. No checkout or purchase flow is provided.
# AI_FREE_PLAN_PRICE_USD=0
# AI_PRO_PLAN_PRICE_USD=your_configured_price

# Optional dedicated speech/translation providers.
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
# GOOGLE_TRANSLATION_API_KEY=your_google_translation_api_key
