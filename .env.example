# ==============================================================================
# RoyalArm AI Environment Variables
# Copy this file to .env.local for local development. Never commit .env.local.
# ==============================================================================

# Optional server-only provider key. Leave unset for local-only mode.
OPENAI_API_KEY=your_openai_api_key_here

# Configurable OpenAI Model (e.g., gpt-4o-mini, gpt-4o, gpt-4.1-mini)
OPENAI_MODEL=gpt-4o-mini
